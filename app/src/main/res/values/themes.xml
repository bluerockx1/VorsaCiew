<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme — Compose handles Material3 theming at runtime.
         This theme only covers the window background and status bar before
         Compose takes over. -->
    <style name="Theme.VorsaCiew" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
